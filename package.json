{
  "name": "jevnest-lab",
  "version": "0.1.0",
  "private": true,
  "description": "SVGnest Classic baseline and placement-policy experiments",
  "scripts": {
    "test": "node tests/placement-instrumentation.test.cjs",
    "benchmark:setup": "playwright install chromium",
    "benchmark": "node scripts/run-corpus.cjs",
    "jev:prepare": "node scripts/evaluate-jev.cjs",
    "jev:evaluate": "node scripts/evaluate-jev.cjs --live",
    "test:jev": "node --test tests/jev-offline.test.cjs tests/jev-resume.test.cjs tests/jev-live-recovery.test.cjs",
    "jev:replay": "node scripts/replay-jev.cjs",
    "benchmark:full": "node scripts/full-jev-benchmark.cjs",
    "benchmark:jev": "node scripts/full-jev-benchmark.cjs --live",
    "test:jev-full": "node --test tests/jev-full.test.cjs",
    "benchmark:production": "node scripts/production-jev-benchmark.cjs",
    "test:production": "node --test tests/jev-production.test.cjs",
    "questions:prepare": "node scripts/jev-question-study.cjs prepare",
    "questions:collect": "node scripts/jev-question-study.cjs collect",
    "questions:score": "node scripts/jev-question-study.cjs score",
    "test:questions": "node --test tests/jev-questions.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "playwright": "1.62.1"
  }
}
